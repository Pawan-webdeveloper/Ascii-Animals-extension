{
  "manifest_version": 3,
  "name": "ASCII Animals New Tab",
  "version": "1.1.0",
  "description": "Replaces the new tab page with drifting pixel and ASCII animals behind a glass search bar.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "search", "topSites", "favicon"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
